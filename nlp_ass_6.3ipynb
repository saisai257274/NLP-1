    {
      "cell_type": "markdown",
      "metadata": {
        "id": "dbee5b54"
      },
      "source": [
        "**Reasoning**:\n",
        "I will re-run the CountVectorizer on the updated 'Cleaned_Headline' column and fit new LDA and NMF models to observe how the removal of stop words affects the discovered topics and their keywords.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 331
        },
        "id": "e68e6d31",
        "outputId": "3cd741d8-cda7-49d7-9db7-e452b60d89f3"
      },
      "source": [
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.decomposition import LatentDirichletAllocation, NMF\n",
        "import numpy as np\n",
        "\n",
        "# 1. Vectorize the updated cleaned headlines (with stop words removed)\n",
        "vectorizer_updated = CountVectorizer()\n",
        "bow_matrix_updated = vectorizer_updated.fit_transform(df_new_headlines['Cleaned_Headline'])\n",
        "feature_names_updated = vectorizer_updated.get_feature_names_out()\n",
        "\n",
        "# 2. Re-run LDA model with 2 topics\n",
        "lda_updated = LatentDirichletAllocation(n_components=2, random_state=4)\n",
        "lda_output_updated = lda_updated.fit_transform(bow_matrix_updated)\n",
        "\n",
        "# 3. Re-run NMF model with 2 topics\n",
        "nmf_updated = NMF(n_components=2, random_state=42, init='nndsvd')\n",
        "nmf_output_updated = nmf_updated.fit_transform(bow_matrix_updated)\n",
        "\n",
        "# Update the DataFrame with the new dominant topic assignments\n",
        "df_new_headlines['LDA_Topic_NoStop'] = np.argmax(lda_output_updated, axis=1)\n",
        "df_new_headlines['NMF_Topic_NoStop'] = np.argmax(nmf_output_updated, axis=1)\n",
        "\n",
        "# Helper function to display top keywords\n",
        "def get_top_keywords(model, features, n=5):\n",
        "    results = []\n",
        "    for topic_idx, topic in enumerate(model.components_):\n",
        "        top_indices = topic.argsort()[::-1][:n]\n",
        "        results.append(\", \".join([features[i] for i in top_indices]))\n",
        "    return results\n",
        "\n",
        "print('Updated LDA Topic Keywords:')\n",
        "for i, keywords in enumerate(get_top_keywords(lda_updated, feature_names_updated)):\n",
        "    print(f'Topic {i}: {keywords}')\n",
        "\n",
        "print('\\nUpdated NMF Topic Keywords:')\n",
        "for i, keywords in enumerate(get_top_keywords(nmf_updated, feature_names_updated)):\n",
        "    print(f'Topic {i}: {keywords}')\n",
        "\n",
        "print('\\nUpdated Headlines with Topic Assignments (Stop Words Removed):')\n",
        "display(df_new_headlines[['Headline', 'Cleaned_Headline', 'LDA_Topic_NoStop', 'NMF_Topic_NoStop']])"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Updated LDA Topic Keywords:\n",
            "Topic 0: match, virat, century, scored, elections\n",
            "Topic 1: form, congress, government, state, took\n",
            "\n",
            "Updated NMF Topic Keywords:\n",
            "Topic 0: match, scored, virat, century, wicket\n",
            "Topic 1: state, form, congress, government, wicket\n",
            "\n",
            "Updated Headlines with Topic Assignments (Stop Words Removed):\n"
          ]
        },
